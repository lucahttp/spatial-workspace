layout_mode = 2
size_flags_horizontal = 3
text = "ESTADO: BREATHING"

[node name="FoundryLive" type="Label" parent="Margin/Column/Header"]
layout_mode = 2
text = "● FOUNDRY LIVE"
modulate = Color(0.1, 0.9, 0.5, 1)

[node name="EqualizerRow" type="HBoxContainer" parent="Margin/Column/Header"]
