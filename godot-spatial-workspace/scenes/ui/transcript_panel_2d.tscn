[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/transcript_panel.gd" id="1_transcript"]
[ext_resource type="Theme" path="res://assets/themes/vaporwave_sunset.tres" id="2_theme"]

[node name="TranscriptPanel2D" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_transcript")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 18
