; Engine configuration file.
; Spatial Workspace XR — native Godot port (vertical slice)
;
; Targets Godot 4.3+ (opens fine on 4.5). XR is enabled through the
; OpenXR module; the Apple RealityKit plugin for Vision Pro registers its own
; XRInterface at runtime and is detected by scripts/xr/xr_manager.gd.

config_version=5

[application]

config/name="Spatial Workspace XR"
config/description="Native Godot XR port of the spatial workspace. Grip moves objects, trigger activates controls."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=0

[xr]

openxr/enabled=true
openxr/startup_alert=false
openxr/foveation_level=0
openxr/foveation_dynamic=false
openxr/foveation_eye_tracked=false
openxr/foveation_with_subsampled_images=false
openxr/extensions/hand_tracking=true
shaders/enabled=true
